<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence
		xmlns="https://jakarta.ee/xml/ns/persistence"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="
	        https://jakarta.ee/xml/ns/persistence
    	    https://jakarta.ee/xml/ns/persistence/persistence_4_0.xsd"
		version="4.0">
	<persistence-unit name="my-persistence-unit">
        <description>Persistence-Hub.com</description>
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
		<class>com.thorben.janssen.model.ChessPlayer</class>
		<class>com.thorben.janssen.model.ChessClub</class>
		<class>com.thorben.janssen.persistence.ChessClubQueries</class>
		<exclude-unlisted-classes>false</exclude-unlisted-classes>

		<default-to-one-fetch-type>LAZY</default-to-one-fetch-type>
		<properties>
			<property name="hibernate.generate_statistics" value="true" />

			<property name="hibernate.highlight_sql" value="true"/>
			<property name="hibernate.format_sql" value="true"/>
			
			<property name="hibernate.jdbc.batch_size" value="5"/>

			<property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres" />
			<property name="jakarta.persistence.jdbc.user" value="postgres" />
			<property name="jakarta.persistence.jdbc.password" value="postgres" />

			<property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create" />
		</properties>
	</persistence-unit>
</persistence>
